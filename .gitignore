# --- secrets and local settings -------------------------------------------
# Twitch client secret, OAuth tokens, YouTube Music pairing token, and every
# overlay setting live here. Never commit this folder.
config/

# --- installed plugins ------------------------------------------------------
# Plugins are copied here from catalog/ when you install them (the + tab); what
# ships with Hexcast is catalog/. Keep the folder, not what is installed in it.
plugins/*
!plugins/.gitkeep

# --- media library ---------------------------------------------------------
# Keep the folder structure, not the contents.
media/*
!media/.gitkeep
!media/*/
media/*/*
!media/*/.gitkeep

# Generated alongside media files
*.poster.jpg

# --- python ----------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- editors and OS --------------------------------------------------------
.vscode/
.idea/
*.code-workspace
Thumbs.db
desktop.ini
.DS_Store

# --- misc ------------------------------------------------------------------
*.log
.env
/.serena
games.json
games_craps_table.json
games_craps_table.json.bad
games_craps_table.json.*.tmp
games_roulette_table.json
games_roulette_table.json.bad
games_roulette_table.json.*.tmp
